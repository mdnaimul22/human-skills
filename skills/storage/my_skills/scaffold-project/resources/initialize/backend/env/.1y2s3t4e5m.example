# System Resource Control Plane Configuration
# Hot-reloaded at runtime by SystemManager; thresholds are validated before applying.

SYSTEM_TELEMETRY_POLL_INTERVAL_SEC=2.0
SYSTEM_TELEMETRY_CACHE_TTL_SEC=2.0
SYSTEM_HEARTBEAT_INTERVAL_SEC=60.0
SYSTEM_REAPER_INTERVAL_SEC=30.0
SYSTEM_DEFAULT_LEASE_TTL_SEC=300.0
SYSTEM_CPU_EWMA_ALPHA=0.4
SYSTEM_LOAD_RECOVERY_STREAK=3
SYSTEM_LOAD_HYSTERESIS_PCT=5.0

# Hard Usage Ceilings (90% defaults)
SYSTEM_MAX_CPU_USAGE_PERCENT=90.0
SYSTEM_RESERVED_CPU_CORES=1
SYSTEM_MAX_RAM_USAGE_PERCENT=90.0
SYSTEM_MIN_FREE_RAM_MB=1024

# LoadLevel Pressure Thresholds
SYSTEM_CPU_ELEVATED_PCT=75.0
SYSTEM_CPU_CRITICAL_PCT=88.0
SYSTEM_CPU_EMERGENCY_PCT=95.0
SYSTEM_RAM_ELEVATED_PCT=80.0
SYSTEM_RAM_CRITICAL_PCT=90.0
SYSTEM_RAM_EMERGENCY_PCT=95.0
SYSTEM_RAM_ELEVATED_FREE_MB=1536
SYSTEM_RAM_CRITICAL_FREE_MB=768
SYSTEM_RAM_EMERGENCY_FREE_MB=384

# GPU / NVENC Governance & WSL2
SYSTEM_GPU_ENABLED=true
SYSTEM_GPU_LIB_DIRS=/usr/lib/wsl/lib
SYSTEM_GPU_PROBE_TIMEOUT_SEC=2.0
SYSTEM_GPU_CANARY_TIMEOUT_SEC=3.0
SYSTEM_GPU_MAX_VRAM_USAGE_PERCENT=90.0
SYSTEM_GPU_MIN_FREE_VRAM_MB=512
SYSTEM_GPU_MAX_TEMP_C=83
SYSTEM_GPU_MAX_UTIL_PERCENT=90.0
SYSTEM_GPU_MAX_NVENC_SESSIONS=3
SYSTEM_GPU_ENCODE_CPU_THREADS=2
SYSTEM_GPU_ENCODE_VRAM_MB=512
SYSTEM_GPU_ML_VRAM_MB=1536

# Workload Caps & Tier Ratios
SYSTEM_MAX_RENDER_SLOTS=4
SYSTEM_MAX_AUDIO_SLOTS=4
SYSTEM_MAX_ML_SLOTS=2
SYSTEM_ENCODE_MAX_THREADS=8
SYSTEM_RENDER_MAX_THREADS=6
SYSTEM_TIER_GUEST_CPU_RATIO=0.50
SYSTEM_TIER_REGISTERED_CPU_RATIO=0.75
SYSTEM_TIER_PREMIUM_CPU_RATIO=1.00
SYSTEM_TIER_GUEST_RAM_MB=256
SYSTEM_TIER_REGISTERED_RAM_MB=512
SYSTEM_TIER_PREMIUM_RAM_MB=2048
SYSTEM_GPU_ALLOWED_TIERS=registered,premium

# Hardware Encoder Circuit Breaker
SYSTEM_BREAKER_FAILURE_THRESHOLD=3
SYSTEM_BREAKER_COOLDOWN_SEC=600.0
SYSTEM_BREAKER_HALF_OPEN_TIMEOUT_SEC=15.0
